---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
{% assign feed_posts = site.posts | where: 'lang', page.lang | where_exp: 'post', 'post.draft != true' | sort: 'date' | reverse %}
{% assign feed_labels = site.data.subscriptions[page.lang] %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ page.lang }}">
  <title>{{ feed_labels.feed_title | xml_escape }}</title>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url | xml_escape }}"/>
  <link rel="alternate" type="text/html" href="{{ site.data.i18n[page.lang].home_url | absolute_url | xml_escape }}" hreflang="{{ page.lang }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | default: site.author | xml_escape }}</name></author>
  {% for post in feed_posts limit: 20 %}
    <entry xml:lang="{{ post.lang }}">
      <title type="text">{{ post.title | xml_escape }}</title>
      <id>{{ post.url | absolute_url | xml_escape }}</id>
      <link rel="alternate" type="text/html" href="{{ post.url | absolute_url | xml_escape }}"/>
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
      <summary type="text">{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
      <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | xml_escape }}</content>
      {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}
    </entry>
  {% endfor %}
</feed>
